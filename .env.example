# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
LOCAL_BURN_CAPTIONS=true
LOCAL_HEURISTIC_FALLBACK=true
SHORTS_MAX_UPLOAD_MB=2048
# Desktop shell defaults to an embedded WebView2 window. Set to true to force
# the legacy browser launcher.
SHORTS_STUDIO_BROWSER=false
SHORTS_PORT=7860
SHORTS_AUTO_RESUME=true
SHORTS_MIN_FREE_GB=0.5
